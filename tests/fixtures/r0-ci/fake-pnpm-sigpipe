#!/usr/bin/env bash
if [[ "$1 $2 $3" == 'pkg get scripts.test:browser' ]]; then
  printf '"playwright test -c playwright.config.ts"\n'
  for _ in $(seq 1 200000); do printf '{}\n'; done
  exit 0
fi
if [[ "$1 $2" == 'run test:browser' ]]; then
  printf ran > "$R0_FAKE_BROWSER_MARKER"
  exit 0
fi
exit 64
