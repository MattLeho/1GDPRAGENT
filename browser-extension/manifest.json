{
  "manifest_version": 3,
  "name": "GDPR Agent Browser Connector",
  "version": "0.1.0",
  "description": "Locally synchronises explicitly authorised browser history with GDPR Agent.",
  "permissions": ["storage", "alarms"],
  "optional_permissions": ["history"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "GDPR Agent Browser Connector"
  }
}
